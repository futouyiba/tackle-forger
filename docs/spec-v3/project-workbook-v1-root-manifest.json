    "path": "lib/types.ts",
    "interface": "WorkspaceState",
    "rootCount": 93
  },
  "workbookSchema": {
    "schema": "project-workbook-machine-sheets/v1",
    "sheetOrder": [
      "__TF_MANIFEST",
      "__TF_CURRENT",
      "__TF_PRESERVED",
      "__TF_ROOT_REFS",
      "__TF_DIAGNOSTICS",
      "README",
      "ROOT_SUMMARY"
    ],
    "rejectUnknownSheets": true,
    "rejectUnknownColumns": true,
    "rejectFormulaCellsInMachineSheets": true,
    "sheets": {
      "__TF_MANIFEST": {
        "kind": "machine",
        "columns": [
          "contract_version",
          "workspace_id",
          "base_workspace_revision",
          "root_manifest_sha256",
          "workbook_schema_sha256",
          "exporter_version",
          "machine_content_sha256"
        ],
        "primaryKey": [
          "contract_version"
        ],
        "cardinality": "EXACTLY_ONE"
      },
      "__TF_CURRENT": {
        "kind": "machine",
        "columns": [
          "root",
          "record_schema_id",
          "record_key",
          "record_revision",
          "record_content_sha256",
          "payload_json"
        ],
        "primaryKey": [
          "root",
          "record_key"
        ],
        "cardinality": "ZERO_OR_MORE"
      },
      "__TF_PRESERVED": {
        "kind": "machine",
        "columns": [
          "root",
          "record_key",
          "record_revision",
          "record_content_sha256",
          "opaque_canonical_payload_json"
        ],
        "primaryKey": [
          "root",
          "record_key"
        ],
        "cardinality": "ZERO_OR_MORE"
      },
      "__TF_ROOT_REFS": {
        "kind": "machine",
        "columns": [
          "root",
          "classification",
          "root_content_sha256",
          "opaque_server_ref"
        ],
        "primaryKey": [
          "root"
        ],
        "cardinality": "EXACTLY_ALL_SERVER_OWNED_AND_FORBIDDEN_ROOTS"
      },
      "__TF_DIAGNOSTICS": {
        "kind": "machine",
        "columns": [
          "root",
          "record_key",
          "severity",
          "code",
          "message",
          "subject_ref",
          "content_sha256"
        ],
        "primaryKey": [
          "root",
          "record_key",
          "code"
        ],
        "cardinality": "ZERO_OR_MORE"
      },
      "README": {
        "kind": "derived_readable",
        "columns": [
          "section",
          "content"
        ],
        "primaryKey": [
          "section"
        ],
        "cardinality": "ONE_OR_MORE"
      },
      "ROOT_SUMMARY": {
        "kind": "derived_readable",
        "columns": [
          "root",
          "classification",
          "record_count",
          "root_content_sha256",
          "status"
        ],
        "primaryKey": [
          "root"
        ],
        "cardinality": "EXACTLY_93"
      }
    },
    "classificationProjection": {
      "importable_current": {
        "sheet": "__TF_CURRENT",
        "payloadPolicy": "CLOSED_RECORD_SCHEMA"
      },
      "preserved_frozen": {
        "sheet": "__TF_PRESERVED",
        "payloadPolicy": "OPAQUE_EXACT_SERVER_EXPORT_ONLY"
      },
      "server_owned": {
        "sheet": "__TF_ROOT_REFS",
        "payloadPolicy": "HASH_AND_OPAQUE_REF_ONLY"
      },
      "forbidden": {
        "sheet": "__TF_ROOT_REFS",
        "payloadPolicy": "HASH_AND_OPAQUE_REF_ONLY"
      },
      "export_only_diagnostic": {
        "sheet": "__TF_DIAGNOSTICS",
        "payloadPolicy": "CLOSED_DERIVED_DIAGNOSTIC_FIELDS_ONLY"
      }
    }
  },
  "canonicalization": {
    "textEncoding": "UTF-8",
    "unicodeNormalization": "NFC",
    "lineEndings": "LF",
    "jsonCanonicalization": "RFC8785_JCS",
    "finiteNumbersOnly": true,
    "negativeZero": "NORMALIZE_TO_ZERO",
    "blankAndNullDistinct": true,
    "rowOrder": "ROOT_MANIFEST_ORDER_THEN_PRIMARY_KEY_CODEPOINT_ASC",
