      "__TF_PRESERVED",
      "__TF_ROOT_REFS",
      "__TF_DIAGNOSTICS"
    ],
    "machineContentHashExcludes": [
      "__TF_MANIFEST.machine_content_sha256",
      "README",
      "ROOT_SUMMARY"
    ],
    "hashAlgorithm": "SHA-256",
    "semanticEquivalence": "CANONICAL_MACHINE_CONTENT_SHA256_EQUAL"
  },
