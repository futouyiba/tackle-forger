{
  "name": "tackle-forger",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "config-export:companion": "tsx scripts/config-export-companion.ts",
    "config-export:companion:build": "tsx scripts/build-companion.ts",
    "storage:migrate:blob-to-sqlite": "tsx scripts/migrate-blob-to-sqlite.ts",
    "storage:backup": "tsx scripts/backup-workspace.ts",
    "storage:verify-backup": "tsx scripts/verify-workspace-backup.ts",
    "ai-retention:sweep": "tsx scripts/sweep-ai-retention.ts",
    "acceptance:phase-one": "node -- scripts/phase-one-acceptance.mjs",
    "governance:check-pr": "node scripts/check-pr-merge-gate.mjs",
    "test": "npm run build && tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern apps/web --ignore-pattern packages",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/blob": "^2.6.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "eslint@9.39.4": {
      "minimatch@3.1.5": {
        "brace-expansion": "1.1.16"
      }
    },
    "eslint-config-next@16.2.12": {
      "typescript-eslint@8.59.3": {
        "@typescript-eslint/typescript-estree@8.59.3": {
          "minimatch@10.2.5": {
            "brace-expansion": "5.0.8"
          }
        }
      }
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.23",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5"
  },
  "type": "module"
}
